# ═══════════════════════════════════════════════════════════════════════════════
# SHYMKENT STUDIO — environment variables
# Local development: copy to .env.local and fill in. Production: set the same
# names in the hosting panel (Vercel → Settings → Environment Variables) or in
# the server's env file. NEVER commit real values. Check with: npm run env:check
#
# [required]            the app does not start without it
# [required in prod]    required when NODE_ENV=production
# [optional]            leave empty to switch the feature off
# ═══════════════════════════════════════════════════════════════════════════════

# ─── Database ────────────────────────────────────────────────────────────────
# [required] PostgreSQL 16 (primary data store). Managed providers usually need
# ?sslmode=require. For serverless (Vercel) use the provider's pooled URL and
# add &connection_limit=5 (see docs/DEPLOYMENT.md).
DATABASE_URL=postgresql://USER:PASSWORD@localhost:5432/shymkent_dev?schema=public
# [optional, dev/CI only] Integration tests and `npm run db:drift` create a
# temporary database on this server and drop it afterwards (needs CREATEDB).
DATABASE_URL_TEST=postgresql://USER:PASSWORD@localhost:5432/shymkent_test?schema=public

# ─── CRM auth ────────────────────────────────────────────────────────────────
# [required] ≥ 32 random characters. Keys rate-limit hashes and encrypts the
# Google token stored in the DB. Generate:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
# Rotating it signs nobody out, but Google Calendar must be reconnected.
AUTH_SECRET=
# [required in prod] Public origin, https only (cookies get Secure + __Host-,
# OAuth redirect URI, links in emails). Local: http://localhost:3000
AUTH_URL=http://localhost:3000

# First owner account, created by `npm run db:seed` only if it does not exist.
# The initial password is used once: change it in CRM → «Мой аккаунт», then
# delete OWNER_INITIAL_PASSWORD. Seeding never changes an existing password.
OWNER_EMAIL=
OWNER_NAME=
OWNER_INITIAL_PASSWORD=

# ─── Public site ─────────────────────────────────────────────────────────────
# [required in prod] Canonical URL used in sitemap, robots, canonical tags, Open
# Graph and JSON-LD. Baked into the build: rebuild after changing it.
NEXT_PUBLIC_SITE_URL=https://shymkent.studio
# Studio name, phone, WhatsApp, email, Instagram, address, map link and opening
# date are edited in CRM → Настройки → «Контакты студии» (not here).

# ─── Email (SMTP) ────────────────────────────────────────────────────────────
# [optional] Either SMTP (all three) …
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
# Sender, e.g. "SHYMKENT STUDIO <salem@shymkent.studio>" (defaults to SMTP_USER).
SMTP_FROM=
# … or Gmail / Google Workspace with an app password (used when SMTP_HOST is empty).
GMAIL_USER=
GMAIL_APP_PASSWORD=
# Where "new booking / new tour request" notifications go.
ADMIN_NOTIFICATION_EMAIL=

# ─── Google Calendar (optional) ──────────────────────────────────────────────
# OAuth client of type "Web application". Authorised redirect URI:
#   {AUTH_URL}/api/auth/callback
# Connect the account in CRM → Настройки → Интеграции (owner only); the refresh
# token is then stored encrypted in the database.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_CALENDAR_ID=
# Fallback only (prefer the CRM connection above).
GOOGLE_CALENDAR_REFRESH_TOKEN=

# ─── Google Sheets mirror (optional) ─────────────────────────────────────────
# Apps Script web-app URL (https). PostgreSQL stays the source of truth; the
# sheet gets one row per booking, updated by booking number (docs/INTEGRATIONS.md).
GOOGLE_APPS_SCRIPT_URL=

# ─── Cron / integration outbox ───────────────────────────────────────────────
# [required in prod] ≥ 32 random characters, different from AUTH_SECRET.
# Protects GET/POST /api/cron/outbox (Authorization: Bearer $CRON_SECRET).
# Vercel Cron sends this header automatically.
CRON_SECRET=
# Pause between runs of `npm run outbox:worker` (seconds).
OUTBOX_INTERVAL_SECONDS=30
# Completed jobs older than this are deleted (failed jobs are kept for review).
OUTBOX_RETENTION_DAYS=30
# true = never call email / Google (jobs are recorded as done). Demos, staging,
# E2E. Tests always run in this mode.
INTEGRATIONS_DRY_RUN=false

# ─── Proxy ───────────────────────────────────────────────────────────────────
# How many reverse proxies append to X-Forwarded-For in front of the app
# (Vercel: 1, nginx/Caddy → app: 1, Cloudflare → nginx → app: 2, none: 0).
# Used for rate limiting; a wrong value lets clients spoof their IP.
TRUSTED_PROXY_COUNT=1

# ─── Monitoring / logging ────────────────────────────────────────────────────
# debug | info | warn | error (default: info in production, debug otherwise).
# Logs are JSON lines with request ids; personal data is redacted.
LOG_LEVEL=
# Local production-mode runs only (E2E on http://localhost): relaxes the
# https/localhost production checks. Never set this on the real server.
# APP_ENV=local

# ─── Maintenance scripts (optional) ──────────────────────────────────────────
# npm run db:backup → BACKUP_DIR (default ./backups, git-ignored).
BACKUP_DIR=
# npm run db:restore-check restores into a temporary database on this server
# (defaults to the server of DATABASE_URL; prefer a non-production server).
RESTORE_CHECK_DATABASE_URL=

# Kaspi: there is no automatic Kaspi integration (no public API agreement).
# Payment links are created in Kaspi Pay and pasted into the booking in the CRM;
# payments are confirmed manually.
